# ---------------------------------------------------------------
# Kopieren nach .env und anpassen:  cp .env.example .env
# ---------------------------------------------------------------

# Hostname des Mailservers (A-Record + PTR müssen darauf zeigen).
# Alle Domains nutzen diesen einen Host als MX / IMAP / SMTP.
MAIL_HOSTNAME=mail.example.com

# Zertifikat für HTTPS:
#   E-Mail-Adresse -> Let's Encrypt (Produktivbetrieb)
#   internal       -> Caddy-eigene CA (lokaler Test, zusammen mit TLS_MODE=selfsigned)
CADDY_TLS=admin@example.com

# Domains, die beim allerersten Start angelegt werden (kommagetrennt).
# Weitere Domains später über die Weboberfläche.
INITIAL_DOMAINS=example.com,example.org

# Diese LDAP-Benutzer (Mailadresse) dürfen die Weboberfläche nutzen.
ADMIN_USERS=admin@example.com

# Zufälliger Schlüssel für Web-Sessions:  openssl rand -hex 32
SECRET_KEY=bitte-aendern

# ---------------- LDAP ----------------
# Docker-Netz deines OpenLDAP-Stacks (docker network ls)
LDAP_DOCKER_NETWORK=openldap_default

# Containername deines OpenLDAP im obigen Netz
LDAP_URI=ldap://openldap:389
LDAP_BASE_DN=dc=example,dc=com

# Lesender Bind-Benutzer (osixia: LDAP_READONLY_USER=true aktivieren)
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PW=readonly-passwort

# Suchfilter für Postfach-Benutzer. %s = Mailadresse (Login).
# Beispiel nur Mitglieder einer Gruppe (memberOf-Overlay nötig):
# LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(mail=%s)(memberOf=cn=mail,ou=groups,dc=example,dc=com))
LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(mail=%s))

# Attribut mit der Mailadresse
LDAP_MAIL_ATTR=mail

# ---------------- Quota ----------------
# Standard-Speicherlimit pro Postfach in MB (0 = unbegrenzt).
# Einzelne Postfächer lassen sich in der Weboberfläche abweichend setzen.
QUOTA_DEFAULT_MB=5120

# Schlüssel für die interne Dovecot-API (Weboberfläche liest darüber
# die Postfachbelegung):  openssl rand -hex 32
DOVEADM_API_KEY=bitte-aendern

# Optional: Standard-LDAP-Attribut mit dem Speicherlimit (kein Zusatzschema nötig).
# Werte z. B.  quota=10G   quota=500M   quota=0 (unbegrenzt)   oder  10G
# Ohne Einheit = MB. Andere Werte im Attribut (z. B. normale Beschreibung) werden ignoriert.
# Ist ein Wert gesetzt, hat er Vorrang vor Weboberfläche und Standard.
# Leer lassen = nicht verwenden.
LDAP_QUOTA_ATTR=description

# Wie oft die LDAP-Werte abgeglichen werden (Sekunden)
LDAP_QUOTA_SYNC_SECONDS=300

# ---------------- Sonstiges ----------------
# Zeitzone (u. a. für Beginn/Ende der Abwesenheitsnotiz)
TZ=Europe/Berlin

# Maximale Mailgröße in Bytes (50 MB)
MESSAGE_SIZE_LIMIT=52428800

# TLS_MODE=caddy       -> Zertifikat von Caddy (Let's Encrypt) übernehmen
# TLS_MODE=selfsigned  -> selbstsigniert (nur zum lokalen Testen)
TLS_MODE=caddy
